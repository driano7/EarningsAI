# ─── Telegram Bot ──────────────────────────────────────────────
# Token del bot de Telegram (de @BotFather)
TELEGRAM_BOT_TOKEN=

# ─── Vercel KV (Redis) ─────────────────────────────────────────
# Se obtienen del dashboard de Vercel > Storage > KV
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ─── Dashboard Auth ────────────────────────────────────────────
# Contraseña del dashboard (default: Donovan)
DASHBOARD_PASSWORD=Donovan

# ─── Finnhub (datos de mercado) ────────────────────────────────
# API key de Finnhub.io (gratuita con límite de 60 req/min)
FINNHUB_API_KEY=

# ─── OpenRouter (análisis con IA) ──────────────────────────────
# API key de OpenRouter.ai para análisis de earnings con IA
OPENROUTER_API_KEY=

# ─── CoinGecko ─────────────────────────────────────────────────
# No requiere API key — usa la API pública gratuita
# Límite: ~10-30 req/min sin key

# ─── Blockchain APIs (Pagos Crypto) ────────────────────────────
# Opcionales — mejoran la verificación de transacciones
ETHERSCAN_API_KEY=
ARBISCAN_API_KEY=
OPTIMISTIC_API_KEY=
LINEASCAN_API_KEY=
SNOWTRACE_API_KEY=
