{
  "framework": "nextjs",
  "crons": [
    { "path": "/api/cron-morning",   "schedule": "0 13 * * 1-5" },
    { "path": "/api/cron-afternoon", "schedule": "30 20 * * 1-5" },
    { "path": "/api/cron-evening",   "schedule": "0 23 * * 1-5" },
    { "path": "/api/cron-weekly",    "schedule": "0 14 * * 1" },
    { "path": "/api/cron-news",      "schedule": "0 8 * * 1-5" }
  ],
  "functions": {
    "api/webhook.ts": { "maxDuration": 60 },
    "api/cron-morning.ts": { "maxDuration": 300 },
    "api/cron-afternoon.ts": { "maxDuration": 300 },
    "api/cron-evening.ts": { "maxDuration": 300 },
    "api/cron-weekly.ts": { "maxDuration": 300 },
    "api/cron-news.ts": { "maxDuration": 300 }
  }
}
